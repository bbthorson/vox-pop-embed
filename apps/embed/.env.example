# apps/embed build-time env vars. Vite inlines `VITE_*` into the bundle.

# Origin of the Vox Pop BFF (@vox-pop/api) — the embed's only backend.
# Anonymous calls: public prompt read + the pending audio upload.
VITE_VOXPOP_API_BASE_URL=http://localhost:8091

# Origin of apps/public — embed redirects the top frame here after upload
# so OTP completes on a same-origin handler. See ReplyDot.submitPendingEmbed.
VITE_HOST_APP_BASE_URL=http://localhost:9002
